<Window x:Class="BirthdayApp.Views.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Dialog" Height="310" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="41.058"/>
            <RowDefinition Height="Auto" MinHeight="39.96"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="First Name"/>
            <TextBox x:Name="FirstName" Text="{Binding FirstName}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Last Name"/>
            <TextBox x:Name="LastName" Text="{Binding LastName}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Email"/>
            <TextBox x:Name="Email" Text="{Binding Email}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Birth Date"/>
            <DatePicker  x:Name="BirthDatePicker" SelectedDate="{Binding BirthDate}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Is Adult"/>
            <CheckBox Content="Повнолітній" IsChecked="{Binding IsAdult, Mode=OneWay}" IsEnabled="False" />
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 0 20" Width="160">
            <Button Content="OK"  Width="75" Margin="0,0,10,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="75" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>